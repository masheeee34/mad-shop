# ==========================================
# CONFIGURATION STRIPE (Paiements)
# ==========================================
# Clé secrète Stripe (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=sk_test_...

# Secret du Webhook Stripe (whsec_...)
# En local : généré avec `stripe listen --forward-to localhost:3000/api/webhook`
# En prod  : généré dans Stripe Dashboard > Développeurs > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ==========================================
# CONFIGURATION SITE & NAVIGATION
# ==========================================
# URL de base de la boutique (ex: http://localhost:3000 ou https://votredomaine.fr)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numéro WhatsApp sans le '+' (ex: 33612345678)
NEXT_PUBLIC_WHATSAPP=

# ==========================================
# EMAIL & NOTIFICATIONS (Resend)
# ==========================================
# Clé API Resend (re_...)
RESEND_API_KEY=

# Expéditeur des emails (domaine à vérifier sur Resend)
EMAIL_FROM=MAD Shop <onboarding@resend.dev>

# Email de la boutique qui reçoit les alertes de commandes
EMAIL_TO=contact@madshop.fr

# ==========================================
# INTELLECT ARTIFICIEL (Optionnel)
# ==========================================
ANTHROPIC_API_KEY=
