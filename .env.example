# ==============================================================================
# MAD SHOP — Variables d'environnement
# Copiez ce fichier en `.env.local` et complétez-le. Ne commitez jamais de clé.
# La boutique démarre sans aucune de ces valeurs : les fonctionnalités
# concernées (paiement, emails, mesure) restent simplement inactives.
# ==============================================================================

# ------------------------------------------------------------------------------
# STRIPE — Paiements
# ------------------------------------------------------------------------------
# Clé secrète (sk_test_... en développement, sk_live_... en production)
STRIPE_SECRET_KEY=
# Clé publique (pk_test_... / pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret du webhook (whsec_...)
#   En local : stripe listen --forward-to localhost:3000/api/webhook
#   En prod  : Stripe > Développeurs > Webhooks > endpoint /api/webhook
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# SITE & NAVIGATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Numéro WhatsApp sans le '+' (ex: 33612345678)
NEXT_PUBLIC_WHATSAPP=
# Comptes sociaux — URL complète du compte de la boutique.
# Laissés vides, les icônes correspondantes ne sont pas affichées.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# ------------------------------------------------------------------------------
# ADMINISTRATION (/admin)
#   ADMIN_PASSWORD : 12 caractères minimum, refusé s'il vaut "admin", "mad"…
#   ADMIN_SECRET   : 32 caractères minimum — openssl rand -hex 32
#   En production, l'espace admin refuse de fonctionner sans ces deux valeurs.
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SECRET=

# ------------------------------------------------------------------------------
# ESPACE CLIENT (/compte)
#   Signe les liens de connexion sans mot de passe et les liens de reprise de
#   panier. 32 caractères minimum — openssl rand -hex 32.
#   Laissé vide, ADMIN_SECRET est utilisé à la place.
# ------------------------------------------------------------------------------
AUTH_SECRET=

# ------------------------------------------------------------------------------
# PERSISTANCE (production)
#   En build `standalone`, le serveur démarre depuis .next/standalone : sans ces
#   deux dossiers, catalogue, commandes, avis et photos envoyées depuis le
#   back-office sont écrits dans le dossier de build et perdus au déploiement
#   suivant. Pointez-les hors de .next, et sauvegardez DATA_DIR.
#   UPLOAD_DIR doit être servi publiquement sous /products/ (voir
#   DEPLOIEMENT-HOSTINGER.md).
# ------------------------------------------------------------------------------
DATA_DIR=
UPLOAD_DIR=

# ------------------------------------------------------------------------------
# EMAILS TRANSACTIONNELS (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
# Expéditeur (domaine à vérifier sur Resend)
EMAIL_FROM=MAD Shop <onboarding@resend.dev>
# Boîte interne qui reçoit commandes, réservations et messages
EMAIL_TO=contact@madshop.fr

# "manual" pour valider chaque avis client depuis le back-office
REVIEWS_MODERATION=

# ------------------------------------------------------------------------------
# PUBLICITÉ & MESURE
# Aucun script n'est chargé tant qu'un identifiant n'est pas renseigné,
# et rien ne se déclenche avant le consentement du visiteur.
# ------------------------------------------------------------------------------
# Google Analytics 4 — G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Ads — AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Étiquette de conversion "achat" — AW-123456789/AbC-D_efG
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Meta Pixel (Facebook / Instagram)
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Vérification Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
